{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "apps/desktop/src/**/*.ts",
    "vite.config.ts"
  ]
}

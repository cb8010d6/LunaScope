{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LunaScope",
  "version": "0.1.0",
  "identifier": "com.lunascope.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LunaScope",
        "width": 1440,
        "height": 920,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}


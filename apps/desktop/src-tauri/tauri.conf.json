{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LunaScope",
  "version": "0.3.1",
  "identifier": "com.lunascope.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LunaScope",
        "width": 1440,
        "height": 920,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "resizable": true
      },
      {
        "label": "companion",
        "title": "LunaScope Companion",
        "url": "companion.html",
        "width": 360,
        "height": 460,
        "minWidth": 260,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "companion"
      ],
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "D:\\LunaScopeData\\companion\\models\\**",
          "D:\\LunaScopeData\\companion\\preload\\**",
          "D:\\LunaScopeData\\companion\\runtime\\**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}

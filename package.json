{
  "name": "lunascope-workspace",
  "private": true,
  "version": "0.3.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:companion-assets": "node --no-warnings --test apps/desktop/src/companion/vendor/asset-url.test.mjs",
    "test:pixi-runtime": "node --no-warnings --test apps/desktop/src/companion/vendor/pixi-runtime.test.mjs",
    "test:tauri-csp": "node --no-warnings --test apps/desktop/src/tauri-csp.test.mjs",
    "test:environment-preflight": "node --no-warnings --experimental-strip-types --test apps/desktop/src/environment-preflight.test.ts",
    "test:companion-assets": "node --no-warnings --experimental-strip-types --test apps/desktop/src/companion/vendor/asset-url.test.mjs apps/desktop/src/companion/interaction.test.mjs",
    "test:companion-interaction": "node --no-warnings --experimental-strip-types --test apps/desktop/src/companion/interaction.test.mjs",
    "contract:check": "tsc -p packages/runtime-contract/tsconfig.json --noEmit",
    "evals:manifest-check": "node scripts/check-evals.mjs",
    "evals:manifest-test": "node --test scripts/check-evals.test.mjs",
    "evals:check": "npm run evals:manifest-check",
    "evals:tier1": "node scripts/run-tier1-evals.mjs",
    "evals:canary": "node scripts/run-release-canary.mjs",
    "endurance": "node scripts/run-endurance.mjs",
    "release:gate:test": "node --test scripts/release-gate.test.mjs",
    "test:release-secret-scope": "node --test scripts/release-secret-scope.test.mjs",
    "test:release-evidence-redaction": "node --test scripts/redact-sensitive.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@pixi-spine/runtime-3.8": "^3.1.2",
    "@pixi/unsafe-eval": "6.5.10",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "pixi-spine": "^3.1.2",
    "pixi.js": "^6.5.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
